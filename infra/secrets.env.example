# GitHub Actions secrets for the infinite-worship deploy workflow.
# Copy to secrets.env (git-ignored) and fill in real NEW infinite-worship
# values — NEVER stream-of-worship (SOW_*) credentials.
#
# The key names below match `.github/workflows/deploy.yml` exactly, so the
# whole file syncs in one command:
#
#   gh secret set -f secrets.env -R mhuang74/infinite-worship
#
# The same file doubles as the source for local Terraform env vars
# (infra/README.md Phase 3, step 2).
#
# GitHub secrets are write-only: this file is the only readable copy.
# Back it up somewhere safe OUTSIDE the repo.

# Deployer IAM credentials (ECR push + Lambda code update + terraform apply)
AWS_ACCESS_KEY_ID=NEW-deployer-iam-access-key
AWS_SECRET_ACCESS_KEY=NEW-deployer-iam-secret-key

# Cloudflare: NEW token (R2:Edit, Zone:Read, DNS:Edit) + the account/zone
# serving the R2 custom domain. ACCOUNT_ID/ZONE_ID are the same values
# Terraform consumes as TF_VAR_cloudflare_account_id / TF_VAR_cloudflare_zone_id.
CLOUDFLARE_API_TOKEN=NEW-token-for-infinite-worship
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Neon connection string for the NEW project (worker + Terraform)
WORKER_DATABASE_URL=postgresql://user:password@host/dbname

# NEW R2 API token for the worker (also used by the BFF)
WORKER_R2_ACCESS_KEY_ID=NEW-r2-access-key
WORKER_R2_SECRET_ACCESS_KEY=NEW-r2-secret-key
